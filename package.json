{
  "name": "crewhir",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-server && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "assets": "node scripts/brand-assets.mjs",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run build",
    "logos": "node scripts/integration-logos.mjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "@vercel/analytics": "2.0.1",
    "gsap": "3.15.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@fontsource/bricolage-grotesque": "5.3.0",
    "@fontsource/instrument-sans": "5.3.0",
    "@iconify-json/logos": "^1.2.16",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "satori": "0.57.2",
    "schema-dts": "2.1.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
